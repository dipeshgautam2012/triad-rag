# triad-rag shared configuration — template only (safe to commit).
# Copy to env.toml (gitignored) and replace placeholders with real values.

[orchestrator]
retrieval_url = ""
generation_url = ""
request_timeout_s = 60
retry_attempts = 3   # retries if retrieval or generation HTTP call fails (timeout / 502 / 503 / 504); 1 = no retry
retry_wait_s = 0.3   # seconds to sleep before each retry

[retrieval]
corpus_dir = ""
index_store_dir = ""
chunk_size = 800
chunk_overlap = 100
chunker_name = "simple"
available_chunkers = ["simple", "hierarchical", "markdown", "sentence_window", "semantic"]
sentence_window_size = 3
semantic_breakpoint_percentile = 95
semantic_buffer_size = 1
hierarchical_parent_multiplier = 3
hierarchical_expand_parent = true
# available_embedding_models = allowed set; default_embedding_model = used when a
# request doesn't specify one, and must be in the set.
available_embedding_models = [""]
default_embedding_model = ""
embedding_batch_size = 500
max_upload_bytes = 20000000
rerank_enabled = false
rerank_model = "cross-encoder/ms-marco-MiniLM-L-6-v2"
rerank_candidate_multiplier = 4
# Pluggable backends (see changeplan.md): swap implementation via env.toml + factory.py.
vector_backend = "chroma"
node_store_backend = "json"
embedder_backend = "huggingface"
reranker_backend = "cross_encoder"
sparse_backend = "none"  # none | json_bm25 | sqlite_bm25
hybrid_enabled = false
hybrid_candidate_multiplier = 4

# --- Generation ---
# [generation] = shared settings; [generation.<vendor>] = that vendor only.
[generation]
default_provider = "google"
temperature = 0.2
# max_output_tokens = 8192
# max_input_tokens = 12000
# reasoning_effort = "medium"

[generation.google]
default_model = "fast"
api_key = ""

[generation.google.models]
fast = ""
quality = ""

[generation.openai]
default_model = "mini"
api_key = ""

[generation.openai.models]
mini = ""
smart = ""

[generation.anthropic]
default_model = "sonnet"
api_key = ""

[generation.anthropic.models]
haiku = ""
sonnet = ""

[generation.stub]
default_model = "default"
api_key = ""

[generation.stub.models]
default = "stub"
